{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndx.foundation/schemas/document.schema.json",
  "title": "NDX Semantic Document",
  "description": "Experimental NDX v0.1 semantic document model. Not a stable standard.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "modelVersion",
    "metadata",
    "content"
  ],
  "properties": {
    "format": {
      "const": "ndx"
    },
    "modelVersion": {
      "const": "0.1"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "language"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 35
        },
        "creator": {
          "type": "string",
          "maxLength": 500
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "level",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "type": {
                "const": "heading"
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "type": {
                "const": "paragraph"
              },
              "text": {
                "type": "string",
                "maxLength": 100000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "ordered",
              "items"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "type": {
                "const": "list"
              },
              "ordered": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 10000
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "alt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "type": {
                "const": "figure"
              },
              "alt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "caption": {
                "type": "string",
                "maxLength": 5000
              },
              "resource": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        ]
      }
    }
  }
}
